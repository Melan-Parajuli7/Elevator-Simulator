<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test runner for the lift LOGIC (no WinForms, no database, no screen needed).
       It compiles the same source files the real program uses, so a passing run proves the real code works.
       Run it with:   dotnet run --project Lift.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Lift.Tests</RootNamespace>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Elevator_System\Models\*.cs" />
    <Compile Include="..\Elevator_System\Subject\*.cs" />
    <Compile Include="..\Elevator_System\State\*.cs" />
    <Compile Include="..\Elevator_System\Observer\*.cs" />
    <Compile Include="..\Elevator_System\Controller\ElevatorDispatcher.cs" />
    <Compile Include="..\Elevator_System\Controller\ElevatorSystem.cs" />
    <Compile Include="..\Elevator_System\Controller\HallCallResult.cs" />
    <Compile Include="..\Elevator_System\Controller\Passenger.cs" />
    <Compile Include="..\Elevator_System\Controller\PassengerActivity.cs" />
    <Compile Include="..\Elevator_System\Controller\PassengerSimulator.cs" />
    <Compile Include="..\Elevator_System\Data\LogEntry.cs" />
    <Compile Include="..\Elevator_System\Data\ILogWriter.cs" />
    <Compile Include="..\Elevator_System\Data\IElevatorLogRepository.cs" />
    <Compile Include="..\Elevator_System\Data\BackgroundLogWriter.cs" />
    <Compile Include="..\Elevator_System\Data\DbBackgroundRunner.cs" />
    <Compile Include="..\Elevator_System\Data\SqlScript.cs" />
    <Compile Include="..\Elevator_System\Data\DataAccessException.cs" />
  </ItemGroup>

</Project>
